# Production settings are generated by scripts/install.sh into .env (never commit it). Reference for every variable: docs/OPERATIONS.md.
# Local host development (npm run dev) only: copy to .env.local.
DEMO_MODE=true                 # demo users, fixture seed, /api/demo, mock provider. Never set in production.
LIVE_AI_ENABLED=false
STORAGE_ROOT=runtime/storage
# Docker Compose supplies DATABASE_URL internally; the database is not published.
# Live extraction (production: AI_PROVIDER=gemini, key in secrets/gemini_key):
# AI_PROVIDER=gemini            # or anthropic (benchmarks)
# GEMINI_API_KEY_FILE=/run/secrets/gemini_key
# EXTRACTION_MODEL=gemini-3.5-flash-lite
# AI_INPUT_USD_PER_MILLION=0.30
# AI_OUTPUT_USD_PER_MILLION=2.50
# AI_PRICING_VERSION=gemini-3.5-flash-lite-2026-10-28
# AI_RUN_BUDGET_USD=5.00        # monthly cap (calendar month, Europe/London)
# AI_ORDER_BUDGET_USD=0.25      # per order
# BUDGET_RELEASE_GRACE_MINUTES=15
# SESSION_COOKIE_SECURE=false   # default is true outside DEMO_MODE
# Odoo major version for the CSV export dialect (17, 18 or 19; default 19). Direct push detects it.
# ODOO_VERSION=19
