{
  "name": "pennbridge-order-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname 127.0.0.1 --port 3087",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 0.0.0.0 --port 3087",
    "worker": "tsx apps/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "fixtures:check": "python3 scripts/validate_fixtures.py",
    "seed:generate": "python3 scripts/generate_scale.py",
    "seed:check": "python3 scripts/validate_scale.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "bcryptjs": "3.0.3",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "lucide-react": "1.63.0",
    "mailparser": "3.12.4",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "2.4.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
